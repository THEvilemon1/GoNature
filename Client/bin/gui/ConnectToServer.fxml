<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="250.0" prefWidth="420.0"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="gui.ConnectToServerController">

    <!-- Title -->
    <Label layoutX="110.0" layoutY="25.0" text="Connect to Server">
        <font><Font name="Arial Bold" size="20.0" /></font>
    </Label>

    <!-- IP -->
    <Label layoutX="50.0" layoutY="95.0" text="Server IP:" />
    <TextField fx:id="txtIP" layoutX="170.0" layoutY="92.0" prefWidth="200.0" promptText="e.g. 192.168.1.1" />

    <!-- Status -->
    <Label fx:id="lblStatus" layoutX="50.0" layoutY="140.0" prefWidth="320.0" text="" />

    <!-- Buttons -->
    <Button fx:id="btnConnect" layoutX="105.0" layoutY="185.0" prefWidth="110.0"
        text="Connect" onAction="#connect" />
    <Button fx:id="btnExit" layoutX="235.0" layoutY="185.0" prefWidth="80.0"
        text="Exit" onAction="#exit" />

</AnchorPane>
