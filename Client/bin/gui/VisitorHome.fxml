<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.VisitorHomeController"
           styleClass="root-pane"
           stylesheets="@VisitorHome.css">

    <VBox fx:id="viewMain" alignment="CENTER">
        <VBox styleClass="visitor-card" prefWidth="900" maxWidth="980">
            <VBox styleClass="card-header" spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="app-name" text="GoNature" />
                        <Label styleClass="app-tagline" text="National Parks Reservation System" />
                    </VBox>
                    <Button styleClass="btn-back" text="Logout" onAction="#handleLogoutButton" />
                </HBox>
                <Label fx:id="lblVisitorDetails" styleClass="visitor-details" text="" />
            </VBox>

            <Separator styleClass="card-sep">
                <VBox.margin><Insets top="4" bottom="16" /></VBox.margin>
            </Separator>

            <HBox spacing="18" alignment="CENTER">
                <VBox styleClass="action-card" spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label styleClass="card-title" text="Book a Visit" />
                    <Label styleClass="card-desc"
                           text="Plan your next national park experience and secure your spot."
                           wrapText="true" />
                    <Region VBox.vgrow="ALWAYS" />
                    <Button styleClass="card-btn-primary" text="Book Now"
                            onAction="#handlePrimaryAction" maxWidth="Infinity" />
                </VBox>

                <VBox styleClass="action-card" spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label styleClass="card-title" text="My Bookings" />
                    <Label styleClass="card-desc"
                           text="View, edit, or cancel your existing park reservations."
                           wrapText="true" />
                    <Region VBox.vgrow="ALWAYS" />
                    <Button styleClass="card-btn-secondary" text="View"
                            onAction="#handleSecondaryAction" maxWidth="Infinity" />
                </VBox>

                <VBox styleClass="action-card" spacing="12" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label styleClass="card-title" text="Profile" />
                    <Label styleClass="card-desc"
                           text="View and update your saved contact information."
                           wrapText="true" />
                    <Region VBox.vgrow="ALWAYS" />
                    <Button styleClass="card-btn-secondary" text="Edit Profile"
                            onAction="#handleProfileAction" maxWidth="Infinity" />
                </VBox>
            </HBox>
        </VBox>
    </VBox>

    <VBox fx:id="viewDetail" visible="false" managed="false" alignment="CENTER">
        <VBox styleClass="visitor-card" prefWidth="900" maxWidth="980" maxHeight="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button styleClass="btn-back" text="Back" onAction="#handleBack" />
                <Label fx:id="lblDetailTitle" styleClass="detail-title" text="" />
            </HBox>

            <Separator styleClass="card-sep">
                <VBox.margin><Insets top="14" bottom="14" /></VBox.margin>
            </Separator>

            <VBox fx:id="bookingForm" styleClass="detail-body" spacing="14">
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Name" />
                    <TextField fx:id="txtName" promptText="Enter your name" maxWidth="Infinity" />
                </VBox>

                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Email Address" />
                        <TextField fx:id="txtEmail" promptText="Enter email address" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Phone Number" />
                        <TextField fx:id="txtPhoneNumber" promptText="Enter phone number" maxWidth="Infinity" />
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label styleClass="field-label" text="Visitors" />
                    <Spinner fx:id="spnVisitors" editable="true" maxWidth="120" />
                    <Label fx:id="lblVisitorHint" styleClass="field-help"
                           text="Choose between 1 and 6 visitors."
                           wrapText="true" />
                </VBox>

                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Park" />
                        <ComboBox fx:id="cmbPark" maxWidth="Infinity" promptText="Choose a park" />
                        <Label fx:id="lblSelectedParkPrice" styleClass="field-help"
                               text="Select a park to see its price per person."
                               wrapText="true" />
                    </VBox>

                    <VBox styleClass="price-summary" spacing="6" prefWidth="260">
                        <Label styleClass="price-summary-title" text="Booking Price" />
                        <Label fx:id="lblPricePerPerson" styleClass="price-summary-line"
                               text="Price per person: --" />
                        <Label fx:id="lblTotalPrice" styleClass="price-summary-total"
                               text="Total: --" />
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Date" />
                        <DatePicker fx:id="dateVisit" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Time" />
                        <ComboBox fx:id="cmbTime" maxWidth="Infinity" promptText="Choose time" />
                    </VBox>
                </HBox>

                <Label fx:id="lblBookingMessage" styleClass="booking-message" text="" wrapText="true" visible="false" />

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button styleClass="card-btn-secondary" text="Cancel" onAction="#handleCancelForm" />
                    <Button fx:id="btnSubmitBooking" styleClass="card-btn-primary" text="Submit Booking" onAction="#handleSubmitBooking" />
                </HBox>
            </VBox>

            <VBox fx:id="bookingsListView" visible="false" managed="false" spacing="12">
                <Label fx:id="lblBookingsMessage" styleClass="booking-message" text="" wrapText="true" visible="false" />
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="520" VBox.vgrow="ALWAYS" styleClass="bookings-scroll">
                    <VBox fx:id="bookingsList" spacing="10" />
                </ScrollPane>
            </VBox>

            <VBox fx:id="profileForm" visible="false" managed="false" styleClass="detail-body" spacing="14">
                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="First Name" />
                        <TextField fx:id="txtProfileFirstName" promptText="Enter first name" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Last Name" />
                        <TextField fx:id="txtProfileLastName" promptText="Enter last name" maxWidth="Infinity" />
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Email Address" />
                        <TextField fx:id="txtProfileEmail" promptText="Enter email address" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Phone Number" />
                        <TextField fx:id="txtProfilePhoneNumber" promptText="Enter phone number" maxWidth="Infinity" />
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label styleClass="field-label" text="Club Member" />
                    <TextField fx:id="txtProfileClubMember" editable="false" focusTraversable="false" maxWidth="160" />
                    <Label styleClass="field-help"
                           text="Only a service representative can change club member status."
                           wrapText="true" />
                </VBox>

                <Label fx:id="lblProfileMessage" styleClass="booking-message" text="" wrapText="true" visible="false" />

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnEditProfile" styleClass="card-btn-secondary" text="Edit" onAction="#handleEditProfile" />
                    <Button fx:id="btnCancelProfile" styleClass="card-btn-secondary" text="Cancel" onAction="#handleCancelProfileEdit" />
                    <Button fx:id="btnSaveProfile" styleClass="card-btn-primary" text="Save Profile" onAction="#handleSaveProfile" />
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
