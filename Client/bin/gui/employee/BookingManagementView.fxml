<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.employee.BookingManagementViewController"
           styleClass="root-pane"
           stylesheets="@EmployeeScreens.css">

    <VBox styleClass="screen-card" maxWidth="560" alignment="TOP_CENTER">

        <!-- Top bar -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="0">
            <Label styleClass="screen-title" text="Booking Management" />
            <Region HBox.hgrow="ALWAYS" minWidth="20" />
            <Label fx:id="lblCurrentVisitors" styleClass="top-bar-info" text="Current Visitors: --" />
        </HBox>

        <!-- Content -->
        <VBox styleClass="content-area" spacing="16">

            <Label fx:id="lblWelcome" styleClass="welcome-label" text="Welcome!" />

            <!-- Main action buttons -->
            <HBox spacing="16" alignment="CENTER">
                <Button styleClass="btn-big, btn-primary" text="Enter Visitor"
                        onAction="#handleEnterVisitor" prefWidth="240" />
                <Button styleClass="btn-big, btn-danger" text="Exit Visitor"
                        onAction="#handleExitVisitor" prefWidth="240" />
            </HBox>

            <Separator styleClass="card-sep" />

            <!-- Today's bookings -->
            <Label styleClass="field-label" text="Today's Bookings" />

            <HBox spacing="14">
                <!-- Pending list -->
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="list-header-pending" text="Pending" />
                    <ListView fx:id="lstPending" prefHeight="160" />
                </VBox>

                <!-- Checked-in list -->
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="list-header-checkedin" text="Checked In" />
                    <ListView fx:id="lstCheckedIn" prefHeight="160" />
                </VBox>
            </HBox>

            <Separator styleClass="card-sep" />

            <!-- Logout -->
            <HBox alignment="CENTER_LEFT">
                <Button styleClass="btn-secondary" text="Logout"
                        onAction="#handleLogout" prefWidth="100" />
            </HBox>

        </VBox>
    </VBox>
</StackPane>
