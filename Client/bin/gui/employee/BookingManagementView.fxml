<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.employee.BookingManagementViewController"
           styleClass="root-pane"
           stylesheets="@EmployeeScreens.css">

    <VBox styleClass="screen-card" maxWidth="620" alignment="TOP_CENTER">

        <!-- ── Top bar ─────────────────────────────────────────── -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="0">
            <VBox spacing="2">
                <Label styleClass="screen-title" text="Booking Management" />
                <Label fx:id="lblWelcome" styleClass="welcome-label-top" text="Welcome!" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" minWidth="16" />
            <VBox alignment="CENTER_RIGHT" spacing="1" styleClass="visitors-badge">
                <Label styleClass="visitors-caption" text="INSIDE PARK" />
                <Label fx:id="lblCurrentVisitors" styleClass="visitors-count" text="--" />
            </VBox>
        </HBox>

        <!-- ── Main content ────────────────────────────────────── -->
        <VBox styleClass="content-area" spacing="18">

            <!-- TODAY'S BOOKINGS — primary work surface -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="section-title" text="Today's Bookings" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="btn-refresh" text="⟳  Refresh" onAction="#handleRefresh" />
            </HBox>

            <HBox spacing="14">
                <!-- Confirmed → waiting to enter -->
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label styleClass="list-header-pending" text="Confirmed" />
                        <Label styleClass="list-header-sub" text="· waiting to enter" />
                    </HBox>
                    <TextField fx:id="txtSearchBookingId" styleClass="field-input-search"
                               promptText="Search by booking ID..." />
                    <ListView fx:id="lstPending" prefHeight="160" />
                </VBox>

                <!-- Checked in → currently inside -->
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label styleClass="list-header-checkedin" text="Checked In" />
                        <Label styleClass="list-header-sub" text="· inside the park" />
                    </HBox>
                    <ListView fx:id="lstCheckedIn" prefHeight="190" />
                </VBox>
            </HBox>

            <!-- Selected booking detail + action -->
            <VBox fx:id="detailBox" styleClass="booking-details-box" spacing="12"
                  visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="booking-details-title" text="Booking Details" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDetailStatus" styleClass="booking-status-badge" text="" />
                </HBox>

                <GridPane styleClass="booking-details-grid" hgap="18" vgap="10">
                    <Label styleClass="booking-detail-key" text="Booking ID"
                           GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="lblDetailBookingId" styleClass="booking-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="booking-detail-key" text="Name"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblDetailName" styleClass="booking-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="booking-detail-key" text="Visitors"
                           GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblDetailVisitors" styleClass="booking-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="booking-detail-key" text="Visit Time"
                           GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <Label fx:id="lblDetailTime" styleClass="booking-detail-value"
                           GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <Label styleClass="booking-detail-key" text="Price"
                           GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <Label fx:id="lblDetailPrice" styleClass="booking-detail-value"
                           GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </GridPane>

                <Label fx:id="lblActionStatus" styleClass="lbl-message" text="" wrapText="true"
                       visible="false" managed="false" />
                <HBox styleClass="booking-action-row" alignment="CENTER_RIGHT">
                    <Button fx:id="btnBookingAction" text="" onAction="#handleBookingAction"
                            visible="false" managed="false" prefWidth="220" />
                </HBox>
            </VBox>

            <Separator styleClass="card-sep" />

            <!-- ── MANUAL ENTRY — secondary, edge-case actions ── -->
            <VBox spacing="10">
                <VBox spacing="3">
                    <Label styleClass="section-title-manual" text="Manual Entry" />
                    <Label styleClass="section-subtitle-manual"
                           text="For walk-ins without a booking, or to exit a visitor by ID" />
                </VBox>
                <HBox spacing="12">
                    <Button styleClass="btn-manual-enter" text="Walk In Visitor"
                            onAction="#handleEnterVisitor"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    <Button styleClass="btn-manual-exit" text="Exit Visitor"
                            onAction="#handleExitVisitor"
                            HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                </HBox>
            </VBox>

            <Separator styleClass="card-sep" />

            <!-- Logout -->
            <HBox alignment="CENTER_LEFT">
                <Button styleClass="btn-secondary" text="Logout"
                        onAction="#handleLogout" prefWidth="100" />
            </HBox>

        </VBox>
    </VBox>
</StackPane>
