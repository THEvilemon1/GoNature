<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.employee.ParkVisitorsReportViewController"
           styleClass="root-pane"
           stylesheets="@EmployeeScreens.css">

    <VBox styleClass="screen-card" prefWidth="900" maxWidth="980" alignment="TOP_CENTER">

        <!-- Top bar -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="0">
            <Label styleClass="screen-title" text="Park Visitors Report" />
            <Region HBox.hgrow="ALWAYS" minWidth="20" />
            <Button styleClass="btn-secondary" text="✕ Close" onAction="#handleClose" />
        </HBox>

        <!-- Content -->
        <VBox styleClass="content-area" spacing="18">

            <!-- Filters -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label styleClass="field-label" text="Month:" />
                <ComboBox fx:id="monthComboBox" promptText="Select Month" prefWidth="160" />
                <Label styleClass="field-label" text="Year:" />
                <ComboBox fx:id="yearComboBox" promptText="Select Year" prefWidth="120" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="btn-primary" text="Generate Report"
                        onAction="#handleGenerateReport" prefWidth="170" />
                <Button fx:id="btnSendReport" styleClass="btn-secondary" text="Send to Department Manager"
                        onAction="#handleSendReport" prefWidth="220" />
            </HBox>

            <Separator styleClass="card-sep" />

            <TextArea fx:id="reportArea" prefHeight="180" editable="false" wrapText="true" />

            <PieChart fx:id="visitorsPieChart" prefHeight="320" title="Visitors by Type" />

        </VBox>
    </VBox>
</StackPane>
