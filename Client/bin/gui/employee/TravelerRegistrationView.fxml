<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.employee.TravelerRegistrationViewController"
           styleClass="root-pane"
           stylesheets="@EmployeeScreens.css">

    <VBox styleClass="screen-card" maxWidth="520" alignment="TOP_CENTER">

        <!-- Top bar -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label styleClass="screen-title" text="Traveler Registration" />
        </HBox>

        <!-- Content -->
        <VBox styleClass="content-area" spacing="14">

            <Label fx:id="lblWelcome" styleClass="welcome-label" text="Welcome!" />

            <Separator styleClass="card-sep" />

            <!-- Registration type -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="Registration Type" />
                <ComboBox fx:id="cmbType" prefWidth="456" promptText="Select type" />
            </VBox>

            <!-- First name -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="First Name" />
                <TextField fx:id="txtFirstName" styleClass="field-input" promptText="Enter first name" />
            </VBox>

            <!-- Last name -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="Last Name" />
                <TextField fx:id="txtLastName" styleClass="field-input" promptText="Enter last name" />
            </VBox>

            <!-- National ID -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="National ID" />
                <TextField fx:id="txtNationalId" styleClass="field-input" promptText="Enter national ID" />
            </VBox>

            <!-- Email -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="Email" />
                <TextField fx:id="txtEmail" styleClass="field-input" promptText="Enter email" />
            </VBox>

            <!-- Phone -->
            <VBox spacing="6">
                <Label styleClass="field-label" text="Phone Number" />
                <TextField fx:id="txtPhone" styleClass="field-input" promptText="Enter phone number" />
            </VBox>

            <!-- Family members (Club Member only) -->
            <VBox fx:id="boxFamilyMembers" spacing="6" visible="false" managed="false">
                <Label styleClass="field-label" text="Total Family Members" />
                <TextField fx:id="txtFamilyMembers" styleClass="field-input"
                           promptText="Total members in subscription (min 2)" />
            </VBox>

            <!-- Credit card (Club Member only, optional) -->
            <VBox fx:id="boxCreditCard" spacing="6" visible="false" managed="false">
                <Label styleClass="field-label" text="Credit Card (optional)" />
                <TextField fx:id="txtCreditCard" styleClass="field-input"
                           promptText="Leave empty to pay cash" />
            </VBox>

            <!-- Status -->
            <Label fx:id="lblStatus" styleClass="lbl-message" text="" wrapText="true" visible="false" managed="false" />

            <Separator styleClass="card-sep" />

            <!-- Buttons -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="btnRegister" styleClass="btn-primary" text="Register"
                        onAction="#handleRegister" prefWidth="160" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="btn-secondary" text="Logout"
                        onAction="#handleLogout" prefWidth="100" />
            </HBox>

        </VBox>
    </VBox>
</StackPane>
