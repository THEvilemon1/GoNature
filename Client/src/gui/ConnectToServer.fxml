<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.ConnectToServerController"
           styleClass="root-pane"
           stylesheets="@ConnectToServer.css">

    <VBox styleClass="connect-card" alignment="CENTER_LEFT" spacing="18" prefWidth="560" maxWidth="680">
        <VBox spacing="4">
            <Label styleClass="screen-title" text="Connect to Server" />
            <Label styleClass="screen-subtitle" text="Enter the server IP address to start using GoNature." wrapText="true" />
        </VBox>

        <VBox spacing="6">
            <Label styleClass="field-label" text="Server IP" />
            <TextField fx:id="txtIP" styleClass="field-input" promptText="e.g. 192.168.1.1" maxWidth="Infinity" />
        </VBox>

        <Label fx:id="lblStatus" styleClass="status-label" text="" wrapText="true" />

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="btnExit" styleClass="btn-secondary" text="Exit" onAction="#exit" />
            <Button fx:id="btnConnect" styleClass="btn-primary" text="Connect" onAction="#connect" />
        </HBox>
    </VBox>
</StackPane>
