<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="420.0"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="gui.OrderFormController"
    >

    <Label layoutX="120.0" layoutY="20.0" text="Order Details">
        <font>
            <Font name="Arial Bold" size="20.0" />
        </font>
    </Label>

    <!-- Order Number (read only) -->
    <Label layoutX="50.0" layoutY="70.0" text="Order Number:" />
    <TextField fx:id="txtOrderNumber" layoutX="200.0" layoutY="67.0" prefWidth="170.0" editable="false" />

    <!-- Order Date (editable) -->
    <Label layoutX="50.0" layoutY="115.0" text="Order Date (YYYY-MM-DD):" />
    <TextField fx:id="txtOrderDate" layoutX="200.0" layoutY="112.0" prefWidth="170.0" />

    <!-- Number of Visitors (editable) -->
    <Label layoutX="50.0" layoutY="160.0" text="Number of Visitors:" />
    <TextField fx:id="txtNumberOfVisitors" layoutX="200.0" layoutY="157.0" prefWidth="170.0" />

    <!-- Confirmation Code (read only) -->
    <Label layoutX="50.0" layoutY="205.0" text="Confirmation Code:" />
    <TextField fx:id="txtConfirmationCode" layoutX="200.0" layoutY="202.0" prefWidth="170.0" editable="false" />

    <!-- Subscriber ID (read only) -->
    <Label layoutX="50.0" layoutY="250.0" text="Subscriber ID:" />
    <TextField fx:id="txtSubscriberId" layoutX="200.0" layoutY="247.0" prefWidth="170.0" editable="false" />

    <!-- Date of Placing Order (read only) -->
    <Label layoutX="50.0" layoutY="295.0" text="Date of Placing Order:" />
    <TextField fx:id="txtDateOfPlacingOrder" layoutX="200.0" layoutY="292.0" prefWidth="170.0" editable="false" />

    <!-- Status label -->
    <Label fx:id="lblStatus" layoutX="50.0" layoutY="345.0" prefWidth="320.0" text="" style="-fx-text-fill: green;" />

    <!-- Buttons -->
    <Button fx:id="btnSave" layoutX="90.0" layoutY="390.0" prefWidth="100.0"
        text="Save" onAction="#Save" />

    <Button fx:id="btnClose" layoutX="230.0" layoutY="390.0" prefWidth="100.0"
        text="Back" onAction="#closeWindow" />

</AnchorPane>
