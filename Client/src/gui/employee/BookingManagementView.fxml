<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.employee.BookingManagementViewController"
           styleClass="root-pane"
           stylesheets="@EmployeeScreens.css">

    <VBox styleClass="screen-card" maxWidth="560" alignment="TOP_CENTER">

        <!-- Top bar -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="0">
            <Label styleClass="screen-title" text="Booking Management" />
            <Region HBox.hgrow="ALWAYS" minWidth="20" />
            <Label fx:id="lblCurrentVisitors" styleClass="top-bar-info" text="Current Visitors: --" />
        </HBox>

        <!-- Content -->
        <VBox styleClass="content-area" spacing="16">

            <Label fx:id="lblWelcome" styleClass="welcome-label" text="Welcome!" />

            <!-- Main action buttons -->
            <HBox spacing="16" alignment="CENTER">
                <Button styleClass="btn-big, btn-primary" text="Enter Visitor"
                        onAction="#handleEnterVisitor" prefWidth="240" />
                <Button styleClass="btn-big, btn-danger" text="Exit Visitor"
                        onAction="#handleExitVisitor" prefWidth="240" />
            </HBox>

            <Separator styleClass="card-sep" />

            <!-- Today's bookings -->
            <Label styleClass="field-label" text="Today's Bookings" />

            <HBox spacing="14">
                <!-- Pending list -->
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="list-header-pending" text="Pending" />
                    <ListView fx:id="lstPending" prefHeight="160" />
                </VBox>

                <!-- Checked-in list -->
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label styleClass="list-header-checkedin" text="Checked In" />
                    <ListView fx:id="lstCheckedIn" prefHeight="160" />
                </VBox>
            </HBox>

            <!-- Selected booking details + action -->
            <VBox fx:id="detailBox" styleClass="booking-details-box" spacing="12" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblDetailTitle" styleClass="booking-details-title" text="Booking Details" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDetailStatus" styleClass="booking-status-badge" text="" />
                </HBox>

                <GridPane styleClass="booking-details-grid" hgap="18" vgap="10">
                    <Label styleClass="booking-detail-key" text="Booking ID"
                           GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="lblDetailBookingId" styleClass="booking-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="booking-detail-key" text="Name"
                           GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblDetailName" styleClass="booking-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="booking-detail-key" text="Visitors"
                           GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblDetailVisitors" styleClass="booking-detail-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="booking-detail-key" text="Visit Time"
                           GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <Label fx:id="lblDetailTime" styleClass="booking-detail-value"
                           GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <Label styleClass="booking-detail-key" text="Price"
                           GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <Label fx:id="lblDetailPrice" styleClass="booking-detail-value"
                           GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </GridPane>

                <Label fx:id="lblActionStatus" styleClass="lbl-message" text="" wrapText="true"
                       visible="false" managed="false" />
                <HBox styleClass="booking-action-row" alignment="CENTER_RIGHT">
                    <Button fx:id="btnBookingAction" text="" onAction="#handleBookingAction"
                            visible="false" managed="false" prefWidth="160" />
                </HBox>
            </VBox>

            <Separator styleClass="card-sep" />

            <!-- Logout -->
            <HBox alignment="CENTER_LEFT">
                <Button styleClass="btn-secondary" text="Logout"
                        onAction="#handleLogout" prefWidth="100" />
            </HBox>

        </VBox>
    </VBox>
</StackPane>
