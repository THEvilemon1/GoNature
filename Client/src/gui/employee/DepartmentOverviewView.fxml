<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.employee.DepartmentOverviewViewController"
           styleClass="root-pane"
           stylesheets="@EmployeeScreens.css">

    <VBox styleClass="screen-card" prefWidth="960" maxWidth="1040" alignment="TOP_CENTER">

        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Label styleClass="screen-title" text="Department Overview" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblWelcome" styleClass="top-bar-info" text="" />
            <Button styleClass="btn-secondary" text="Logout" onAction="#handleLogout" />
        </HBox>

        <VBox styleClass="content-area" spacing="18" VBox.vgrow="ALWAYS">

            <Label styleClass="field-label" text="SUBMITTED PARK REPORTS" />

            <TableView fx:id="tblReports" styleClass="list-view" prefHeight="220">
                <columns>
                    <TableColumn fx:id="colReportParkId" text="Park ID" prefWidth="90" />
                    <TableColumn fx:id="colReportTitle" text="Report Title" prefWidth="320" />
                    <TableColumn fx:id="colReportEmployeeId" text="Employee ID" prefWidth="120" />
                    <TableColumn fx:id="colReportContent" text="Content" prefWidth="430" />
                </columns>
            </TableView>

            <Separator styleClass="card-sep" />

            <Label styleClass="field-label" text="PARK MANAGER REQUESTS" />

            <TableView fx:id="tblRequests" styleClass="list-view" prefHeight="250">
                <columns>
                    <TableColumn fx:id="colRequest" text="Request" prefWidth="500" />
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120" />
                    <TableColumn fx:id="colApprove" text="" prefWidth="110" />
                    <TableColumn fx:id="colReject" text="" prefWidth="110" />
                </columns>
            </TableView>

            <Label fx:id="lblMessage" styleClass="lbl-message" text=""
                   wrapText="true" maxWidth="700" visible="false" />

            <Button text="Visits Report" onAction="#handleVisitsReport" prefWidth="220" />
            <Button text="Cancellations Report" onAction="#handleCancellationsReport" prefWidth="220" />
            <Button styleClass="btn-secondary" text="Logout" onAction="#handleLogout" prefWidth="120" />
        </VBox>
    </VBox>
</StackPane>