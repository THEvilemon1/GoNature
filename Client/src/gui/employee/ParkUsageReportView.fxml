<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="gui.employee.ParkUsageReportViewController"
           styleClass="root-pane"
           stylesheets="@EmployeeScreens.css">

    <VBox styleClass="screen-card" prefWidth="900" maxWidth="980" alignment="TOP_CENTER">

        <!-- Top bar -->
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="0">
            <Label styleClass="screen-title" text="Park Usage Report" />
            <Region HBox.hgrow="ALWAYS" minWidth="20" />
            <Button styleClass="btn-secondary" text="✕ Close" onAction="#handleClose" />
        </HBox>

        <!-- Content -->
        <VBox styleClass="content-area" spacing="18">

            <!-- Filters -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label styleClass="field-label" text="From:" />
                <DatePicker fx:id="fromDatePicker" />
                <Label styleClass="field-label" text="To:" />
                <DatePicker fx:id="toDatePicker" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="btn-primary" text="Generate Report"
                        onAction="#handleGenerateReport" prefWidth="170" />
            </HBox>

            <Separator styleClass="card-sep" />

            <TextArea fx:id="reportArea" prefHeight="180" editable="false" wrapText="true" />

            <BarChart fx:id="usageChart" prefHeight="320" title="Park Usage By Day">
                <xAxis>
                    <CategoryAxis label="Date" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Usage %" />
                </yAxis>
            </BarChart>

        </VBox>
    </VBox>
</StackPane>
